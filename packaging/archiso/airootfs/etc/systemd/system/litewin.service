[Unit]
Description=Winstaller Automated Windows Deployment Service
After=network-online.target systemd-networkd.service NetworkManager.service dhcpcd.service iwd.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/setfont ter-v24b
ExecStart=/usr/local/bin/litewin
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=no
ExecStopPost=-/usr/bin/systemctl reboot

[Install]
WantedBy=multi-user.target
