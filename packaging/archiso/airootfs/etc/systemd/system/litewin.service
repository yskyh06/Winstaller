[Unit]
Description=Winstaller Automated Windows Deployment Service
After=systemd-vconsole-setup.service winstaller-progress.service winstaller-services-ready.service network.target systemd-networkd.service NetworkManager.service dhcpcd.service iwd.service
Wants=systemd-vconsole-setup.service winstaller-progress.service winstaller-services-ready.service network.target
Conflicts=getty@tty1.service

[Service]
Type=simple
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStartPre=-/usr/bin/setfont ter-v24b
ExecStart=/usr/local/bin/litewin
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=no
# A failed final configuration must leave the machine available for recovery.
ExecStopPost=-/bin/sh -c 'if [ "$SERVICE_RESULT" = success ]; then /usr/bin/systemctl reboot; fi'

[Install]
WantedBy=multi-user.target
